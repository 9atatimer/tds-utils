#!/usr/bin/env bash
# agent-load -- what each coding agent loads at session start in one repo.
#
# For each agent (claude, codex, opencode, omp) it prints one markdown table
# row: the global instruction file the agent reads from $HOME and its bytes,
# the repo instruction file and its bytes, the total, the number of skills in
# the agent's skills directory and the bytes of their descriptions (the list
# every session carries), and ok or over against a byte budget.
#
# Usage: agent-load [-r repo] [-b budget-bytes] [-a agent]
#   -r  repo root (default: the git top level of the current directory)
#   -b  budget in bytes for global + repo file (default 32768, Codex's
#       default project-doc limit and the agent-instructions skill's target)
#   -a  report one agent only
#
# Exit: 0 every agent within budget; 1 an agent over budget; 2 usage error.
# Reads files only; changes nothing. Runbook: docs/ops/agent-load.md.

set -euo pipefail

AGENTS=(claude codex opencode omp)
DEFAULT_BUDGET=32768

# --- Action functions ---

usage() {
    echo "usage: agent-load [-r repo] [-b budget-bytes] [-a agent]   (agents: ${AGENTS[*]})"
}

# is_known_agent <agent> -- succeeds when the agent is in the table.
is_known_agent() {
    local a
    for a in "${AGENTS[@]}"; do
        [[ "$a" == "$1" ]] && return 0
    done
    return 1
}

# agent_files <agent> -- prints "<global path under $HOME> <repo file> <skills dir>".
# The one place that says where each agent reads its instructions and skills.
# A skills dir of "-" means the agent's skills location is not known here.
agent_files() {
    case "$1" in
        claude)   echo ".claude/CLAUDE.md CLAUDE.md .claude/skills" ;;
        codex)    echo ".codex/AGENTS.md AGENTS.md .codex/skills" ;;
        opencode) echo ".config/opencode/AGENTS.md AGENTS.md .claude/skills" ;;
        omp)      echo ".omp/agent/AGENTS.md AGENTS.md -" ;;
    esac
}

# file_bytes <path> -- bytes of the file a path resolves to; 0 when absent.
file_bytes() {
    if [[ -f "$1" ]]; then
        wc -c <"$1" | tr -d ' '
    else
        echo 0
    fi
}

# description_bytes <SKILL.md> -- bytes of the one-line frontmatter
# description, without the key and surrounding quotes.
description_bytes() {
    LC_ALL=C awk '
        NR == 1 && $0 == "---" { inside = 1; next }
        inside && $0 == "---" { exit }
        inside && /^description:/ {
            sub(/^description:[ \t]*/, "")
            sub(/^"/, ""); sub(/"$/, "")
            print length($0); found = 1; exit
        }
        END { if (!found) print 0 }
    ' "$1"
}

# skills_summary <dir> -- prints "<count> <description bytes>", or "- -"
# when the directory is unknown ("-") and "0 0" when it does not exist.
skills_summary() {
    local dir=$1 count=0 desc=0 f
    if [[ "${dir}" == "-" ]]; then
        echo "- -"
        return
    fi
    if [[ -d "${dir}" ]]; then
        for f in "${dir}"/*/SKILL.md; do
            [[ -f "$f" ]] || continue
            count=$((count + 1))
            desc=$((desc + $(description_bytes "$f")))
        done
    fi
    echo "${count} ${desc}"
}

# shown_path <label> <path> -- the label, marked when the file is absent.
shown_path() {
    if [[ -f "$2" ]]; then
        echo "$1"
    else
        echo "$1 (missing)"
    fi
}

# repo_root <dir> -- the git top level of a directory, or the directory.
repo_root() {
    git -C "$1" rev-parse --show-toplevel 2>/dev/null || (cd "$1" && pwd)
}

# --- Flow functions ---

# agent_row <agent> <repo> <budget> -- prints the row; returns 1 when over.
agent_row() {
    local agent=$1 repo=$2 budget=$3
    local global_rel repo_file skills_rel
    read -r global_rel repo_file skills_rel <<<"$(agent_files "${agent}")"
    local global_path="${HOME}/${global_rel}" repo_path="${repo}/${repo_file}"
    local gbytes rbytes total skills_dir verdict
    gbytes=$(file_bytes "${global_path}")
    rbytes=$(file_bytes "${repo_path}")
    total=$((gbytes + rbytes))
    skills_dir="-"
    [[ "${skills_rel}" == "-" ]] || skills_dir="${repo}/${skills_rel}"
    local count desc
    read -r count desc <<<"$(skills_summary "${skills_dir}")"
    verdict=ok
    [[ "${total}" -le "${budget}" ]] || verdict=over
    # The "~/" is a display label, not a path to expand.
    # shellcheck disable=SC2088
    echo "| ${agent} | $(shown_path "~/${global_rel}" "${global_path}") | ${gbytes} | $(shown_path "${repo_file}" "${repo_path}") | ${rbytes} | ${total} | ${count} | ${desc} | ${verdict} |"
    [[ "${verdict}" == ok ]]
}

render_table() {
    local repo=$1 budget=$2
    shift 2
    local agent status=0
    echo "**Agent load: \`${repo}\`** (budget ${budget} bytes)"
    echo
    echo "| agent | global file | global bytes | repo file | repo bytes | total | skills | skill description bytes | budget |"
    echo "|-------|-------------|-------------:|-----------|-----------:|------:|-------:|------------------------:|--------|"
    for agent in "$@"; do
        agent_row "${agent}" "${repo}" "${budget}" || status=1
    done
    return "${status}"
}

# --- Main ---

main() {
    local repo="" budget=${DEFAULT_BUDGET} only="" opt
    while getopts "r:b:a:h" opt; do
        case "$opt" in
            r) repo=$OPTARG ;;
            b) budget=$OPTARG ;;
            a) only=$OPTARG ;;
            h) usage; exit 0 ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    if [[ ! "${budget}" =~ ^[0-9]+$ ]]; then
        echo "agent-load: budget must be a number of bytes, got '${budget}'" >&2
        exit 2
    fi
    if [[ -n "${only}" ]] && ! is_known_agent "${only}"; then
        echo "agent-load: unknown agent '${only}'" >&2
        usage >&2
        exit 2
    fi
    repo=$(repo_root "${repo:-$PWD}")
    local -a agents=("${AGENTS[@]}")
    [[ -z "${only}" ]] || agents=("${only}")
    render_table "${repo}" "${budget}" "${agents[@]}"
}

main "$@"
