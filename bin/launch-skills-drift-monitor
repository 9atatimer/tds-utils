#!/usr/bin/env bash
# launch-skills-drift-monitor -- wrapper for launchd to run the skills-drift
# menu-bar monitor with uv. Mirrors bin/launch-sync-monitor.

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
BIN_PATH="${REPO_ROOT}/bin/skills-drift-monitor"

# Ensure common paths are in PATH for uv
export PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:${PATH}"

if ! command -v uv &> /dev/null; then
    echo "Error: uv not found. Please install uv (brew install uv)."
    exit 1
fi

# Run with uv to handle dependencies on the fly
exec uv run --with rumps --with pyobjc-framework-Cocoa "${BIN_PATH}"
