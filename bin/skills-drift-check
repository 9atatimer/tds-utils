#!/usr/bin/env bash
# skills-drift-check -- read-only drift report for the 9atatimer/Skills
# pipeline (this repo's own skills tree, NOT Vercel's unrelated `skills`
# CLI -- see docs/design/LMDE.DESIGN.md section 2 and lmde/TECH_RADAR.md).
# Writes nothing anywhere. The single source of truth both the RPROMPT
# segment (macos/dot.zshrc) and the menu-bar app (bin/skills-drift-monitor)
# shell out to, so the comparison logic lives in exactly one place.
#
# Usage: skills-drift-check [-h]
#
# Compares up to three sources of the @nine-at-a-time-media/skills version:
#   published  registry latest, via `lmde acquire --latest skills`
#   installed  this machine's acquired stamp,
#              ~/.local/state/tds-utils/acquire/skills.version
#   local      the 9atatimer/Skills repo's own would-be version (same
#              commit-count rule CI uses, scripts/version.mjs), only
#              checked when a clone is found at $SKILLS_REPO_PATH (default
#              ~/workplace/9atatimer/Skills) -- absent there, local is
#              skipped, not reported as drift
#
# Binary semantics (Todd's call, not tri-state): if every source that COULD
# be checked agrees, green. If any one disagrees, not-green. A dirty
# working tree touching the local repo's version-relevant paths also counts
# as drift (uncommitted, so no committed version could ever have been
# published for it yet).
#
# Exit 0 (green, silent) | Exit 1 (drift, one or more `DRIFT:` lines on
# stdout) | Exit 2 (couldn't determine -- e.g. offline / no credential; a
# single stderr note, nothing on stdout). Consumers should treat exit 2 the
# same as exit 0 for display (quiet) -- this mirrors the fail-open stance
# the rest of lmde/clai holds throughout: a flaky network is not a drift
# finding.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
LMDE_BIN="${REPO_ROOT}/bin/lmde"

SKILLS_STATE_FILE="${HOME}/.local/state/tds-utils/acquire/skills.version"
SKILLS_REPO_PATH="${SKILLS_REPO_PATH:-${HOME}/workplace/9atatimer/Skills}"
SKILLS_VERSION_PATHS="skills agents mcp/manifest.json package.json scripts"

DRIFT=0
UNKNOWN=0

note()  { echo "skills-drift-check: $*" >&2; }
drift() { echo "DRIFT: $*"; DRIFT=$((DRIFT + 1)); }

# --- Sources ---

published_version() {
    # Empty stdout means "couldn't resolve" (latest_run's own fail-open
    # contract) -- never a crash, never a nonzero exit worth checking here.
    "${LMDE_BIN}" acquire --latest skills 2>/dev/null || true
}

installed_version() {
    [ -f "${SKILLS_STATE_FILE}" ] && cat "${SKILLS_STATE_FILE}" 2>/dev/null || true
}

# local_version -- echo the 9atatimer/Skills clone's own would-be version at
# SKILLS_REPO_PATH, or "" when no clone is there or it lacks a git history
# (a shallow single-commit checkout, node missing, etc.) -- absence is not
# drift, it just means this source is not in play.
local_version() {
    local repo="${SKILLS_REPO_PATH}"
    [ -d "${repo}/.git" ] || { echo ""; return 0; }
    command -v node >/dev/null 2>&1 || { echo ""; return 0; }
    local count
    # shellcheck disable=SC2086  # SKILLS_VERSION_PATHS is a deliberate word list
    count="$(git -C "${repo}" rev-list --count HEAD -- ${SKILLS_VERSION_PATHS} 2>/dev/null)" || { echo ""; return 0; }
    [ -n "${count}" ] || { echo ""; return 0; }
    node "${repo}/scripts/version.mjs" "${count}" 2>/dev/null || echo ""
}

# local_dirty -- whether SKILLS_REPO_PATH has uncommitted changes touching
# the version-relevant paths. Echoes "1" when dirty, "" otherwise/absent.
local_dirty() {
    local repo="${SKILLS_REPO_PATH}"
    [ -d "${repo}/.git" ] || { echo ""; return 0; }
    local out
    # shellcheck disable=SC2086
    out="$(git -C "${repo}" status --porcelain -- ${SKILLS_VERSION_PATHS} 2>/dev/null)" || { echo ""; return 0; }
    [ -n "${out}" ] && echo "1" || echo ""
}

# --- Main ---

usage() {
    sed -n '2,29p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

main() {
    local opt
    while getopts "h" opt; do
        case "${opt}" in
            h) usage; exit 0 ;;
            *) usage; exit 1 ;;
        esac
    done

    local published installed local_v dirty
    published="$(published_version)"
    installed="$(installed_version)"
    local_v="$(local_version)"
    dirty="$(local_dirty)"

    if [ -z "${published}" ]; then
        note "could not resolve the registry-latest version (offline, or no GitHub Packages credential) -- skipping the drift check this run"
        UNKNOWN=1
    else
        if [ -n "${installed}" ] && [ "${installed}" != "${published}" ]; then
            drift "installed ${installed} != published ${published} -- run \`lmde acquire\`"
        fi
        if [ -n "${local_v}" ] && [ "${local_v}" != "${published}" ]; then
            drift "local repo HEAD (${local_v}) != published ${published} -- unmerged/unpublished skill changes at ${SKILLS_REPO_PATH}"
        fi
    fi

    if [ -n "${dirty}" ]; then
        drift "local repo has uncommitted changes under {${SKILLS_VERSION_PATHS// /,}} at ${SKILLS_REPO_PATH}"
    fi

    if [ "${DRIFT}" -gt 0 ]; then
        exit 1
    fi
    if [ "${UNKNOWN}" -eq 1 ]; then
        exit 2
    fi
    exit 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
