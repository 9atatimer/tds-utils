#!/usr/bin/env bash
# launch-chores-monitor -- wrapper for launchd to run the chores menu-bar
# monitor with uv (dependencies on the fly, same mould as launch-sync-monitor)

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
BIN_PATH="${REPO_ROOT}/bin/chores-monitor"

export PATH="/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin:/usr/bin:/bin:${PATH}"

if ! command -v uv &> /dev/null; then
    echo "Error: uv not found. Please install uv (brew install uv)." >&2
    exit 1
fi

exec uv run --with rumps --with pyobjc-framework-Cocoa "${BIN_PATH}"
