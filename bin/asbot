#!/usr/bin/env bash
# asbot -- run one command as 9atatimer-bot from a session running as the owner.
#
# The command runs with the environment `claude-as-bot --print-env` gives:
# the bot's token, commits under the bot's name, GitHub over HTTPS. It runs
# only after `gh api user` proves the login is the bot.
#
# Where the token comes from is claude-as-bot's choice. A `keychain:`
# reference (the token seeded once with bin/seed-bot-token) is read with
# `security`, with no 1Password and so no prompt per call. An op://
# reference runs the command under `op run`, which prompts.
#
# A Keychain token that cannot be read, or that GitHub rejects (a rotated
# token), falls back to TDS_BOT_GH_TOKEN_REF when that is set, with a
# warning to re-seed; without it, nothing runs. A Keychain token that
# authenticates as anyone but the bot never falls back: nothing runs.
#
# Fail-closed where the inline form fails open: in
# `op run --env-file <(claude-as-bot --print-env) -- cmd`, a failing
# claude-as-bot leaves an empty env file and op runs cmd as the owner
# (tds-utils#717). Here the env is captured first and its failure stops
# everything. Holds no credential: claude-as-bot finds the reference
# (TDS_BOT_GH_TOKEN_REF, else the 1Password item tagged agents-gh-bot).
#
# On the op:// path, run it in the foreground: op's 1Password prompt goes
# unseen in a background job and times out.
#
# Usage: asbot <command> [args...]

set -euo pipefail

# --- Constants ---

BOT_LOGIN="9atatimer-bot"

# The identity guard, run by bash with the session's environment in place:
# $0 is the bot's login, "$@" the command.
# shellcheck disable=SC2016 # expanded by the inner bash, not here
GUARD='
    login="$(gh api user --jq .login)" || { echo "asbot: gh api user failed; nothing was run" >&2; exit 1; }
    [[ $login == "$0" ]] || { echo "asbot: GitHub login is ${login:-<none>}, not $0; nothing was run" >&2; exit 1; }
    exec "$@"
'

# --- Action functions ---

usage() {
    sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' >&2
}

die() {
    echo "asbot: $*" >&2
    exit 1
}

# run_op <session env> <cmd...> -- run the command under `op run`, behind
# the identity guard.
run_op() {
    local session_env=$1
    shift
    exec op run --env-file <(printf '%s\n' "${session_env}") -- \
        bash -c "${GUARD}" "${BOT_LOGIN}" "$@"
}

# fallback <why> <session env> <cmd...> -- the Keychain token failed: use
# TDS_BOT_GH_TOKEN_REF if set, else stop.
fallback() {
    local why=$1 session_env=$2 ref=${TDS_BOT_GH_TOKEN_REF:-}
    shift 2
    [[ ${ref} == op://* ]] || die "${why}; re-seed it with bin/seed-bot-token. Nothing was run"
    echo "asbot: ${why}; using TDS_BOT_GH_TOKEN_REF (1Password) instead. Re-seed with bin/seed-bot-token." >&2
    run_op "$(awk -v r="GH_TOKEN=${ref}" '/^GH_TOKEN=/ { print r; next } { print }' <<<"${session_env}")" "$@"
}

# --- Main ---

main() {
    [[ $# -gt 0 ]] || { usage; exit 2; }

    local session_env
    session_env="$(claude-as-bot --print-env)" \
        || die "claude-as-bot --print-env failed; nothing was run"
    [[ -n ${session_env} ]] || die "claude-as-bot printed no environment; nothing was run"

    # The guard runs inside the session's environment, so it checks the
    # identity the command will actually have.
    local ref line token
    ref="$(sed -n 's/^GH_TOKEN=//p' <<<"${session_env}")"
    if [[ ${ref} != keychain:* ]]; then
        run_op "${session_env}" "$@"
    fi

    local login
    token="$(security find-generic-password -s "${ref#keychain:}" -a "${BOT_LOGIN}" -w 2>/dev/null)" || token=""
    [[ -n ${token} ]] || fallback "the Keychain item ${ref#keychain:} could not be read" "${session_env}" "$@"
    while IFS= read -r line; do
        [[ -z ${line} || ${line} == GH_TOKEN=* ]] && continue
        export "${line?}"
    done <<<"${session_env}"
    export GH_TOKEN="${token}"
    token=""
    login="$(gh api user --jq .login 2>/dev/null)" || {
        unset GH_TOKEN
        fallback "GitHub rejected the Keychain token" "${session_env}" "$@"
    }
    [[ ${login} == "${BOT_LOGIN}" ]] \
        || die "GitHub login is ${login:-<none>}, not ${BOT_LOGIN}; nothing was run"
    exec "$@"
}

main "$@"
