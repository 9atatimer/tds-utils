#!/usr/bin/env bash
# lmde -- LMDE component orchestrator (list / install / sync / status / doctor).

set -euo pipefail

# --- Constants ---

LMDE_ROOT="$(cd "$(dirname "$0")/../lmde" && pwd)"
COMPONENTS_DIR="${LMDE_ROOT}/components"

# Install entrypoint candidates, in resolution order.
ENTRYPOINT_CANDIDATES=("setup.sh" "sync.sh")

# The `acquire` verb runs the ONE acquire engine, which ships in
# @nine-at-a-time-media/sandbox with the fleet pins beside it (tds-utils#549,
# SANDBOX-LIFECYCLE.DESIGN.md D2 as revised). tds-utils keeps no copy.

# --- Logging ---

log() {
    echo "[$(date +'%Y-%m-%dT%H:%M:%S%z')] $*"
}

# --- Action functions ---

# list_components -- print the discovered component names, one per line, sorted.
list_components() {
    local dir name
    for dir in "${COMPONENTS_DIR}"/*/; do
        [[ -d "${dir}" ]] || continue
        name="$(basename "${dir}")"
        echo "${name}"
    done | sort
}

# component_dir <name> -- echo the absolute component directory path.
component_dir() {
    local name="$1"
    echo "${COMPONENTS_DIR}/${name}"
}

# component_entrypoint <name> -- echo the absolute path of the component's
# install entrypoint (first executable of setup.sh/sync.sh), or nothing if the
# component is not installable.
component_entrypoint() {
    local name="$1"
    local dir candidate path
    dir="$(component_dir "${name}")"
    for candidate in "${ENTRYPOINT_CANDIDATES[@]}"; do
        path="${dir}/${candidate}"
        if [[ -x "${path}" ]]; then
            echo "${path}"
            return 0
        fi
    done
    return 0
}

# component_healthcheck <name> -- echo the absolute path of the component's
# executable healthcheck.sh, or nothing if absent/not executable.
component_healthcheck() {
    local name="$1"
    local path
    path="$(component_dir "${name}")/healthcheck.sh"
    if [[ -x "${path}" ]]; then
        echo "${path}"
    fi
}

# --- Flow functions ---

# do_list -- show every component with its installable / healthcheck status.
do_list() {
    local name entry health installable hc
    printf '%-20s %-14s %s\n' "COMPONENT" "INSTALLABLE" "HEALTHCHECK"
    while read -r name; do
        [[ -n "${name}" ]] || continue
        entry="$(component_entrypoint "${name}")"
        health="$(component_healthcheck "${name}")"
        if [[ -n "${entry}" ]]; then
            installable="yes ($(basename "${entry}"))"
        else
            installable="no"
        fi
        if [[ -n "${health}" ]]; then
            hc="yes"
        else
            hc="no"
        fi
        printf '%-20s %-14s %s\n' "${name}" "${installable}" "${hc}"
    done < <(list_components)
}

# install_component <name> -- run a single component's install entrypoint.
# Idempotent insofar as the entrypoint itself is. Skips gracefully when the
# component has no installable entrypoint.
install_component() {
    local name="$1"
    local dir entry
    dir="$(component_dir "${name}")"
    if [[ ! -d "${dir}" ]]; then
        log "ERROR: unknown component '${name}' (no directory at ${dir})"
        return 1
    fi
    entry="$(component_entrypoint "${name}")"
    if [[ -z "${entry}" ]]; then
        log "SKIP: component '${name}' is not installable (no executable setup.sh/sync.sh)."
        return 0
    fi
    log "Installing component '${name}' via $(basename "${entry}")..."
    "${entry}"
    log "Component '${name}' install complete."
}

# do_install <component>|--all -- install one named component, or every
# installable component with --all. Refuses to run with no target.
do_install() {
    local target="${1:-}"
    if [[ -z "${target}" ]]; then
        log "ERROR: 'install'/'sync' requires a <component> or --all."
        echo >&2
        usage >&2
        echo >&2
        echo "Available components:" >&2
        do_list >&2
        return 2
    fi
    if [[ "${target}" == "--all" ]]; then
        local name
        while read -r name; do
            [[ -n "${name}" ]] || continue
            install_component "${name}"
        done < <(list_components)
        return 0
    fi
    install_component "${target}"
}

# run_healthcheck <name> -- run a component's healthcheck.sh and set two
# globals in the CALLER's scope: HC_STATUS (OK / DEGRADED / "no healthcheck")
# and HC_OUTPUT (captured output for verbose reporting). It deliberately does
# NOT echo its result: callers must invoke it as a plain statement, never via
# `$(...)`, because a command substitution would run it in a subshell and the
# global assignments would never reach the parent. Never aborts the caller.
run_healthcheck() {
    local name="$1"
    local health
    HC_STATUS=""
    HC_OUTPUT=""
    health="$(component_healthcheck "${name}")"
    if [[ -z "${health}" ]]; then
        HC_STATUS="no healthcheck"
        return 0
    fi
    if HC_OUTPUT="$("${health}" 2>&1)"; then
        HC_STATUS="OK"
    else
        HC_STATUS="DEGRADED"
    fi
}

# do_status -- concise aligned health table across components that have a
# healthcheck. Exits non-zero if any component is DEGRADED.
do_status() {
    local name status any_degraded=0 HC_STATUS="" HC_OUTPUT=""
    printf '%-20s %s\n' "COMPONENT" "STATUS"
    while read -r name; do
        [[ -n "${name}" ]] || continue
        run_healthcheck "${name}"
        status="${HC_STATUS}"
        [[ "${status}" == "DEGRADED" ]] && any_degraded=1
        printf '%-20s %s\n' "${name}" "${status}"
    done < <(list_components)
    return "${any_degraded}"
}

# do_doctor -- verbose health detail; runs ALL healthchecks, never aborting on
# a failure, and prints each component's captured output. Exits non-zero if any
# component reported DEGRADED.
do_doctor() {
    local name status any_degraded=0 HC_STATUS="" HC_OUTPUT=""
    while read -r name; do
        [[ -n "${name}" ]] || continue
        run_healthcheck "${name}"
        status="${HC_STATUS}"
        [[ "${status}" == "DEGRADED" ]] && any_degraded=1
        echo "=== ${name}: ${status} ==="
        if [[ -n "${HC_OUTPUT}" ]]; then
            printf '%s\n' "${HC_OUTPUT}"
        fi
        echo
    done < <(list_components)
    if [[ "${any_degraded}" -ne 0 ]]; then
        log "doctor: one or more components are DEGRADED."
    else
        log "doctor: all components healthy."
    fi
    return "${any_degraded}"
}

# acquire_engine -- the installed `naatm-sandbox` to delegate to: the one in
# ~/.local/bin (where the engine links itself, and where setup persists it)
# before anything else on PATH; "" when there is none.
acquire_engine() {
    if [[ -x "${HOME}/.local/bin/naatm-sandbox" ]]; then
        printf '%s\n' "${HOME}/.local/bin/naatm-sandbox"
        return 0
    fi
    command -v naatm-sandbox 2>/dev/null || true
}

# The first sandbox release whose engine has the `acquire` verb and the row
# that keeps the engine itself current.
ACQUIRE_ENGINE_MIN_VERSION="0.9.0"

# engine_version <engine> -- the version in the package.json beside the
# engine's real path (bin/../package.json), or "" when it cannot be read.
engine_version() {
    local real
    real="$(readlink -f "$1" 2>/dev/null)" || real="$1"
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        "$(dirname "${real}")/../package.json" 2>/dev/null | head -n1 || true
}

# version_lt <a> <b> -- true when semver core <a> is below <b>.
version_lt() {
    local a="${1%%[-+]*}" b="${2%%[-+]*}" i x y
    for i in 1 2 3; do
        x="$(printf '%s' "${a}" | cut -d. -f"${i}")"
        y="$(printf '%s' "${b}" | cut -d. -f"${i}")"
        [[ "${x}" =~ ^[0-9]+$ ]] || x=0
        [[ "${y}" =~ ^[0-9]+$ ]] || y=0
        if (( x < y )); then return 0; fi
        if (( x > y )); then return 1; fi
    done
    return 1
}

# do_acquire [args...] -- `naatm-sandbox acquire` with the arguments
# unchanged; its exit code is lmde's. The engine keeps itself and the fleet
# pins current on every run. With no engine installed, name the one-time
# bootstrap and exit 0: acquire is fail-open.
do_acquire() {
    local engine
    engine="$(acquire_engine)"
    if [[ -z "${engine}" ]]; then
        echo "[lmde acquire] no acquire engine: naatm-sandbox is not installed in ~/.local/bin or on PATH." >&2
        echo "[lmde acquire] Bootstrap it once per machine (needs GH_PAT_NAATM_PACKAGES_RO, a classic PAT with read:packages):" >&2
        echo "[lmde acquire]   npx --yes --package @nine-at-a-time-media/sandbox@latest naatm-sandbox setup" >&2
        echo "[lmde acquire] Skipping acquire; keeping whatever is already installed (fail-open)." >&2
        return 0
    fi
    # An engine older than the verb answers `acquire` with its usage and exit
    # 0, and it cannot update itself, so exec'ing it would leave the machine
    # silently stale for good. A version that cannot be read is trusted.
    local version
    version="$(engine_version "${engine}")" || version=""
    if [[ -n "${version}" ]] && version_lt "${version}" "${ACQUIRE_ENGINE_MIN_VERSION}"; then
        echo "[lmde acquire] ${engine} is sandbox ${version}, older than ${ACQUIRE_ENGINE_MIN_VERSION}: it has no acquire verb and cannot update itself." >&2
        echo "[lmde acquire] Re-bootstrap it once (needs GH_PAT_NAATM_PACKAGES_RO, a classic PAT with read:packages):" >&2
        echo "[lmde acquire]   npx --yes --package @nine-at-a-time-media/sandbox@latest naatm-sandbox setup" >&2
        echo "[lmde acquire] Skipping acquire; keeping whatever is already installed (fail-open)." >&2
        return 0
    fi
    exec "${engine}" acquire "$@"
}

# --- Usage ---

usage() {
    cat <<'EOF'
Usage: lmde <command> [args]

Commands:
  list                    List discovered components (installable / healthcheck).
  install <component>     Run a component's install entrypoint (idempotent).
  install --all          Install every installable component.
  sync [<component>]      Alias for install; reconcile to the pinned manifest.
  sync --all             Sync every installable component.
  status                  Concise health summary (non-zero if any DEGRADED).
  doctor                  Verbose health detail; runs ALL healthchecks.
  acquire [--pins <file>] Run the fleet acquire engine (naatm-sandbox
                          acquire, from @nine-at-a-time-media/sandbox): install
                          the agent-agnostic clai + ast-mcp +
                          git-mirror + skills + gadmin + designomatic +
                          ci-magic npm
                          packages from GitHub Packages (latest by default;
                          --pins pins named packages, floats the rest).
  acquire --check         Advisory-only: report any acquired package behind the
        [--pins <file>]   GitHub Packages latest and exit 0 (installs nothing).
  acquire --latest <name> Print one package's registry-resolved latest version
                          (ignoring any pin) to stdout, or nothing on failure.
                          Installs nothing; always exits 0.

Notes:
  install/sync with no component (and no --all) only prints this help and the
  component list -- it never installs everything implicitly.

  acquire is a first-class verb, distinct from the platform install/sync
  components: it installs @nine-at-a-time-media/clai (onto PATH),
  @nine-at-a-time-media/ast-mcp (at ~/.local/bin/ast-mcp),
  @nine-at-a-time-media/git-mirror, @nine-at-a-time-media/admin (which ships
  the `gadmin` dispatcher, at ~/.local/bin/gadmin),
  @nine-at-a-time-media/designomatic (at ~/.local/bin/designomatic),
  @nine-at-a-time-media/ci-magic (which ships the `naatm-ci-magic` installer,
  at ~/.local/bin/naatm-ci-magic; the ci.magic engine itself lives in the
  installed package directory), and the
  @nine-at-a-time-media/skills DATA package (no binary; symlinked at
  ~/.local/lib/node_modules/@nine-at-a-time-media/skills, the lmde->clai
  boundary convention path) from GitHub Packages (npm.pkg.github.com). Auth is
  resolved in order: GH_PAT_NAATM_PACKAGES_RO (a CLASSIC PAT with the
  read:packages scope), the deprecated GH_AI_TOOLS_PAT, then the machine's
  own `gh auth token`. A default `gh auth login` does NOT grant
  read:packages -- if installs fail to authenticate, run
  `gh auth refresh -h github.com -s read:packages`. Versions float
  to registry latest unless pinned (keys CLAI_VERSION / AST_MCP_VERSION /
  GIT_MIRROR_VERSION / SKILLS_VERSION / ADMIN_VERSION /
  DESIGNOMATIC_VERSION / CI_MAGIC_VERSION; an absent or UNSET key floats). Pin resolution per
  package: an explicit --pins file wins; else the FLEET pins of the newest
  installed @nine-at-a-time-media/sandbox (lib/pins.env) apply; else the
  package floats. The skills and sandbox packages install first and never
  pin themselves. lmde keeps no copy of the engine or the pins: it execs the
  installed naatm-sandbox (~/.local/bin first, then PATH), and with none
  installed prints the one-time bootstrap, npx --yes
  @nine-at-a-time-media/sandbox setup, and exits 0.
  sandbox/pins.env is itself a valid --pins file. acquire is
  fail-open: an unreachable registry, a missing token, or a failed install
  degrades to the already-installed binary with a warning and still exits 0.
  It never edits a shell rc -- if ~/.local/bin is not on PATH it only warns.

  acquire --check is advisory-only: it installs nothing and ALWAYS exits 0, so
  it can ride alongside git commands without ever failing them. A current
  package prints nothing; a pin behind latest prints an amber line, a floating
  package whose installed version is behind latest prints a red line, and an
  unreachable registry / missing token prints a warning. Color is emitted only
  when stdout is a terminal and NO_COLOR is unset or empty (a present, non-empty
  NO_COLOR disables it, per the NO_COLOR convention).
EOF
}

# --- Main ---

main() {
    local cmd="${1:-}"
    [[ $# -gt 0 ]] && shift || true

    case "${cmd}" in
        list)
            do_list
            ;;
        install|sync)
            do_install "${1:-}"
            ;;
        acquire)
            do_acquire "$@"
            ;;
        status)
            do_status
            ;;
        doctor)
            do_doctor
            ;;
        -h|--help|help|"")
            usage
            ;;
        *)
            log "ERROR: unknown command '${cmd}'."
            echo >&2
            usage >&2
            exit 1
            ;;
    esac
}

main "$@"
