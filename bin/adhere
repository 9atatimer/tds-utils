#!/usr/bin/env bash
# adhere -- measure a repository against its own declared architecture.
#
# Thin launcher: resolves the sibling uv project and execs its `adhere`
# console script, so a bare `adhere` on PATH (tiered through ~/.tds/release
# or the dev checkout) reaches the package without a manual install.
# Design: docs/design/DESIGN.ARCH-ADHERENCE.md

set -euo pipefail

# --- Helpers -----------------------------------------------------------------

project_dir() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    printf '%s\n' "${script_dir}/../adherence"
}

require_uv() {
    if ! command -v uv >/dev/null 2>&1; then
        echo "adhere: uv not found on PATH (brew install uv)" >&2
        return 127
    fi
}

# --- Main --------------------------------------------------------------------

# --no-dev keeps the dev group (pytest, ruff, mypy) out of every runtime
# sync; the adherence CI job and the unit suite are what want it.
main() {
    export PATH="/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin:${PATH}"
    require_uv
    exec uv run --quiet --no-dev --project "$(project_dir)" adhere "$@"
}

main "$@"
