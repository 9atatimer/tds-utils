#!/usr/bin/env bash
# chores -- laptop-local herd of LLM-adjacent scheduled jobs.
#
# Thin launcher: resolves the sibling uv project and execs its `chores`
# console script, so a bare `chores` on PATH (tiered through ~/.tds/release
# or the dev checkout) reaches the package without a manual install.
# Design: docs/design/CHORES.DESIGN.md

set -euo pipefail

# --- Helpers -----------------------------------------------------------------

project_dir() {
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    printf '%s\n' "${script_dir}/../chores"
}

require_uv() {
    if ! command -v uv >/dev/null 2>&1; then
        echo "chores: uv not found on PATH (brew install uv)" >&2
        return 127
    fi
}

# --- Main --------------------------------------------------------------------

main() {
    export PATH="/usr/local/bin:/opt/homebrew/bin:${HOME}/.local/bin:${PATH}"
    require_uv
    exec uv run --quiet --project "$(project_dir)" chores "$@"
}

main "$@"
