#!/usr/bin/env bash
# claude-as-bot -- start an agent session that acts on GitHub as 9atatimer-bot.
#
# The owner approves what agents open, and GitHub refuses self-approval, so
# an agent must never act as the owner (tds-internal#285). This runs the
# agent with the bot's token from 1Password, GitHub reached over HTTPS only
# (an SSH remote would authenticate with the owner's key), and commits under
# the bot's name. The agent runs as `clai claude` (clai's hooks and session
# tagging), or bare `claude` where clai is not installed. Only the op://
# reference and the bot's identity touch disk, in a mode-0600 temp file
# removed on exit; the token never does. The owner's own shell and gh login
# are untouched.
#
# Where the token comes from, first match wins:
#   - the login Keychain (macOS), service KEY_SERVICE, seeded once by a
#     human with bin/seed-bot-token. The reference is then
#     keychain:<service>, and the token is read with `security`: no
#     1Password, so no prompt at every launch or `asbot` call. If the item
#     exists but cannot be read, the launch falls back to
#     TDS_BOT_GH_TOKEN_REF with a warning to re-seed, or refuses;
#   - TDS_BOT_GH_TOKEN_REF, an op:// reference, when set (a cloud session,
#     or a machine with no Keychain);
#   - the one 1Password item tagged BOT_TAG, as
#     op://<vault id>/<item id>/credential. No tagged item, several, or a
#     failed `op` (locked, say) refuses: this public repo names the tag,
#     never a vault or an item (Issue#752).
#
# Usage: claude-as-bot [--print-env] [claude args...]
#   --print-env  print the session's environment (the reference, never the
#                token) and exit, without claude. It reads 1Password only
#                to find the reference by tag.

set -euo pipefail

# --- Constants ---

BOT_LOGIN="9atatimer-bot"
BOT_EMAIL="341954893+9atatimer-bot@users.noreply.github.com"
BOT_TAG="agents-gh-bot"
KEY_SERVICE="tds.github.9atatimer-bot"

# The session's env file; global so the EXIT trap can still see it after
# launch() returns.
ENV_FILE=""

# --- Action functions ---

usage() {
    sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'
}

# The variables the session runs with; GH_TOKEN holds the op:// reference,
# which `op run` resolves at launch.
session_env() {
    local ref=$1
    printf '%s\n' \
        "GH_TOKEN=${ref}" \
        "GIT_AUTHOR_NAME=${BOT_LOGIN}" \
        "GIT_AUTHOR_EMAIL=${BOT_EMAIL}" \
        "GIT_COMMITTER_NAME=${BOT_LOGIN}" \
        "GIT_COMMITTER_EMAIL=${BOT_EMAIL}" \
        "GIT_CONFIG_COUNT=2" \
        "GIT_CONFIG_KEY_0=url.https://github.com/.insteadOf" \
        "GIT_CONFIG_VALUE_0=git@github.com:" \
        "GIT_CONFIG_KEY_1=url.https://github.com/.insteadOf" \
        "GIT_CONFIG_VALUE_1=ssh://git@github.com/"
}

# Prints the reference of the one item tagged BOT_TAG; fails otherwise.
reference_by_tag() {
    local items count
    items=$(op item list --tags "${BOT_TAG}" --format json) || return 1
    count=$(jq 'length' <<<"${items}") || return 1
    if [[ ${count} != 1 ]]; then
        echo "claude-as-bot: ${count} 1Password items carry the tag ${BOT_TAG}; want exactly 1" >&2
        return 1
    fi
    jq -r '.[0] | "op://\(.vault.id)/\(.id)/credential"' <<<"${items}"
}

# True when the login Keychain holds the bot's token. Without -w,
# `security` reports the item and reads no secret.
keychain_has_token() {
    command -v security >/dev/null 2>&1 &&
        security find-generic-password -s "${KEY_SERVICE}" -a "${BOT_LOGIN}" >/dev/null 2>&1
}

valid_reference() {
    [[ $1 == op://* || $1 == "keychain:${KEY_SERVICE}" ]]
}

cleanup() {
    if [[ -n ${ENV_FILE} ]]; then
        rm -f "${ENV_FILE}"
        ENV_FILE=""
    fi
}

# Prints the agent command, one word per line: clai wraps claude with its
# pre/post hooks, CLAI_* environment, telemetry tags and tmux label.
agent_command() {
    if command -v clai >/dev/null 2>&1; then
        printf '%s\n' clai claude
    else
        printf '%s\n' claude
    fi
}

# --- Flow functions ---

# The Keychain path: the session's variables are exported into this shell
# (the token too, read with `security`), and the agent inherits them. No
# file, no argv, no 1Password.
launch_from_keychain() {
    local ref=$1
    shift
    local line token
    token=$(security find-generic-password -s "${KEY_SERVICE}" -a "${BOT_LOGIN}" -w 2>/dev/null) || token=""
    if [[ -z ${token} ]]; then
        local fallback=${TDS_BOT_GH_TOKEN_REF:-}
        if [[ ${fallback} != op://* ]]; then
            echo "claude-as-bot: the Keychain item ${KEY_SERVICE} could not be read; re-seed it with bin/seed-bot-token. Nothing was run" >&2
            return 1
        fi
        echo "claude-as-bot: the Keychain item ${KEY_SERVICE} could not be read; using TDS_BOT_GH_TOKEN_REF (1Password) instead. Re-seed with bin/seed-bot-token." >&2
        launch_from_op "${fallback}" "$@"
        return
    fi
    while IFS= read -r line; do
        [[ ${line} == GH_TOKEN=* ]] && continue
        export "${line?}"
    done < <(session_env "${ref}")
    export GH_TOKEN="${token}"
    "$@"
}

# The 1Password path. Not exec: the shell stays to remove the env file,
# and its exit status is the agent's.
launch_from_op() {
    local ref=$1
    shift
    trap cleanup EXIT INT TERM HUP
    ENV_FILE=$(mktemp "${TMPDIR:-/tmp}/claude-as-bot.XXXXXX")
    session_env "$ref" >"$ENV_FILE"
    local rc=0
    op run --env-file "$ENV_FILE" -- "$@" || rc=$?
    cleanup
    return "$rc"
}

launch() {
    local ref=$1
    shift
    local -a agent
    local word
    while IFS= read -r word; do
        agent+=("$word")
    done < <(agent_command)
    if [[ ${ref} == keychain:* ]]; then
        launch_from_keychain "${ref}" "${agent[@]}" "$@"
    else
        launch_from_op "${ref}" "${agent[@]}" "$@"
    fi
}

# --- Main ---

main() {
    local print_env=false
    if [[ ${1:-} == "--print-env" ]]; then
        print_env=true
        shift
    elif [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
        usage
        exit 0
    fi

    local ref=""
    if keychain_has_token; then
        ref="keychain:${KEY_SERVICE}"
    else
        ref=${TDS_BOT_GH_TOKEN_REF:-}
    fi
    if [[ -z $ref ]]; then
        ref=$(reference_by_tag) || {
            echo "claude-as-bot: no bot token: run bin/seed-bot-token once, set TDS_BOT_GH_TOKEN_REF, or tag the token's 1Password item ${BOT_TAG}" >&2
            exit 2
        }
    fi
    if ! valid_reference "$ref"; then
        echo "claude-as-bot: TDS_BOT_GH_TOKEN_REF must be an op:// reference, never a token" >&2
        exit 2
    fi

    if $print_env; then
        session_env "$ref"
        exit 0
    fi
    launch "$ref" "$@"
}

main "$@"
