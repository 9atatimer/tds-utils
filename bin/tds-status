#!/usr/bin/env bash
# tds-status -- read-only drift report for an installed tds environment
# (ENV-DISTRIBUTION). Writes nothing anywhere.
#
# Usage: tds-status [-h]
#
# Checks, against TDS_DIST_ROOT (default ~/.tds/dist, same as tds-install):
#   links    for every package under current/packages/, each LINKS target
#            in $HOME must be a symlink resolving into <distroot>/current/;
#            missing, non-symlink, or retargeted entries are drift
#   version  the version `current` points at must be the newest version
#            dir under <distroot> (calver vYYYY.MM.DD[.n]; the .n suffix
#            compares numerically -- lexical sort would misorder .10)
#   history  tail of <distroot>/log (install/rollback events; a rejected
#            stage never reaches the log, so only what the log has shows)
#
# Exit 0 when no drift, nonzero when any drift is found. No install at all
# (missing distroot or no current symlink) is reported plainly and exits 0,
# UNLESS $HOME still carries symlinks resolving into the distroot (stale
# links from a removed install) -- those are drift and exit nonzero.

set -euo pipefail

TDS_STATUS_SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "${TDS_STATUS_SELF_DIR}/.tds-lib/tds-dist.sh" ]; then
    # running from inside an unpacked artifact (same layout as install.sh)
    # shellcheck source=../lib/tds-dist.sh
    source "${TDS_STATUS_SELF_DIR}/.tds-lib/tds-dist.sh"
else
    # running as bin/tds-status from the repo
    # shellcheck source=../lib/tds-dist.sh
    source "$(dirname "${TDS_STATUS_SELF_DIR}")/lib/tds-dist.sh"
fi

DRIFT=0

note()  { echo "tds-status: $*"; }
drift() { echo "tds-status: DRIFT: $*"; DRIFT=$((DRIFT + 1)); }

# --- Action functions ---

link_target_path() {
    # link_target_path <pair> -> absolute $HOME path of a LINKS target
    # (empty output when the target does not start with ~/)
    local t="${1%%:*}"
    # shellcheck disable=SC2088  # literal ~/ prefix match on pkg data, not tilde expansion
    case "${t}" in
        "~/"*) printf '%s\n' "${HOME}/${t#\~/}" ;;
        *)     printf '%s\n' "" ;;
    esac
}

check_link() {
    # check_link <distroot> <tgt> -- one $HOME link vs current/
    local distroot="$1" tgt="$2" got
    if [ -L "${tgt}" ]; then
        got="$(readlink "${tgt}")"
        case "${got}" in
            "${distroot}/current/"*) ;;
            *) drift "link ${tgt} retargeted -> ${got} (want ${distroot}/current/...)" ;;
        esac
    elif [ -e "${tgt}" ]; then
        drift "link ${tgt} is not a symlink"
    else
        drift "link ${tgt} missing"
    fi
}

newest_version() {
    # newest_version <distroot> -> newest calver version dir name.
    # sort keys: vYYYY lexical, MM/DD/n numeric (a missing .n sorts first)
    local distroot="$1"
    find "${distroot}" -mindepth 1 -maxdepth 1 -type d -name 'v*' \
        | awk -F/ '{ print $NF }' \
        | sort -t . -k1,1 -k2,2n -k3,3n -k4,4n \
        | tail -1
}

check_version() {
    # check_version <distroot> <curver> -- active vs newest staged
    local distroot="$1" curver="$2" newest
    newest="$(newest_version "${distroot}")"
    if [ -n "${newest}" ] && [ "${newest}" != "${curver}" ]; then
        drift "version: current is ${curver} but newest staged is ${newest}"
    fi
}

check_stale_home_links() {
    # check_stale_home_links <distroot> -- with no active install, any
    # $HOME symlink still resolving into the distroot is drift
    local distroot="$1" l got
    while IFS= read -r l; do
        [ -n "${l}" ] || continue
        got="$(readlink "${l}")"
        case "${got}" in
            "${distroot}/"*) drift "stale link ${l} -> ${got} (no active install)" ;;
        esac
    done < <(find "${HOME}" -maxdepth 3 -type l 2>/dev/null || true)
}

# --- Flow functions ---

report_links() {
    # report_links <distroot> -- every LINKS entry of every current package
    local distroot="$1" f pair tgt
    for f in "${distroot}"/current/packages/*.pkg; do
        [ -f "${f}" ] || continue
        for pair in $(tds_dist_get "${f}" LINKS 2>/dev/null || true); do
            tgt="$(link_target_path "${pair}")"
            if [ -z "${tgt}" ]; then
                drift "bad LINKS target in $(basename "${f}"): ${pair}"
                continue
            fi
            check_link "${distroot}" "${tgt}"
        done
    done
}

report_history() {
    # report_history <distroot> -- echo the tail of the install log
    local distroot="$1"
    if [ -f "${distroot}/log" ]; then
        note "history (last 10):"
        tail -n 10 "${distroot}/log" | sed 's/^/  /'
    else
        note "history: no log"
    fi
}

report_status() {
    # report_status <distroot> -- full report; drift lands in DRIFT
    local distroot="$1" cur="${1}/current" curver
    if [ ! -L "${cur}" ]; then
        note "no tds install at ${distroot} (no current version)"
        check_stale_home_links "${distroot}"
        report_history "${distroot}"
        return 0
    fi
    curver="$(basename "$(readlink "${cur}")")"
    note "distroot: ${distroot}"
    note "current: ${curver}"
    report_links "${distroot}"
    check_version "${distroot}" "${curver}"
    report_history "${distroot}"
}

usage() {
    sed -n '2,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

# --- Main ---

main() {
    local opt
    while getopts "h" opt; do
        case "${opt}" in
            h) usage; exit 0 ;;
            *) usage; exit 1 ;;
        esac
    done

    local distroot="${TDS_DIST_ROOT:-${HOME}/.tds/dist}"
    report_status "${distroot}"
    if [ "${DRIFT}" -eq 0 ]; then
        note "no drift"
        exit 0
    fi
    note "${DRIFT} drift finding(s)"
    exit 1
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    main "$@"
fi
