#!/usr/bin/env python3
"""chores-monitor -- macOS menu-bar item for the chores dashboard
(CHORES.DESIGN.md Subsystem 6). Polls `chores status --json` and shows the
quiet broom when nothing needs attention, the red warning triangle when a
chore's last run failed, a breaker pause is active, or the scheduler is
stale -- the same rule the StatusView's needs_attention encodes, so this
file renders and never decides.

Same rumps + launchd mould as bin/skills-drift-monitor, file for file.
"""

import json
import shutil
import subprocess
import sys
from pathlib import Path

import rumps

REPO_ROOT = Path(__file__).resolve().parent.parent
ASSETS_DIR = REPO_ROOT / "chores" / "assets"  # shipped by chores.pkg
ICON_QUIET = str(ASSETS_DIR / "chores-quiet.png")
ICON_ALERT = str(ASSETS_DIR / "chores-alert.png")
CHECK_INTERVAL_SECS = 60


def chores_bin() -> str:
    return shutil.which("chores") or str(REPO_ROOT / "bin" / "chores")


class ChoresMonitor(rumps.App):
    def __init__(self):
        super().__init__("", icon=ICON_QUIET, template=True)
        # Persistent MenuItem objects, re-added by reference (see the
        # skills-drift-monitor comment: menu.clear() destroys callbacks).
        self.status_item = rumps.MenuItem("chores: unknown", callback=self.open_dashboard)
        self.open_item = rumps.MenuItem("Open dashboard", callback=self.open_dashboard)
        self.pause_item = rumps.MenuItem("Pause all", callback=self.toggle_pause)
        self.refresh_item = rumps.MenuItem("Refresh", callback=self.refresh)
        self.quit_item = rumps.MenuItem("Quit", callback=rumps.quit_application)
        self.view = None
        self.last_error = None
        self.timer = rumps.Timer(self.refresh, CHECK_INTERVAL_SECS)
        self.timer.start()
        self.refresh(None)

    def refresh(self, _):
        try:
            result = subprocess.run(
                [chores_bin(), "status", "--json"], capture_output=True, text=True, timeout=30
            )
            if result.returncode != 0:
                raise RuntimeError(result.stderr.strip()[:200] or f"exit {result.returncode}")
            self.view = json.loads(result.stdout)
            self.last_error = None
        except Exception as e:  # never let a broken check crash the item
            print(f"chores-monitor: {e}", file=sys.stderr)
            self.last_error = str(e)
        self.update_ui()

    def update_ui(self):
        self.menu.clear()
        view = self.view
        attention = bool(view and view.get("needs_attention"))
        self.icon = ICON_ALERT if attention else ICON_QUIET
        self.template = not attention
        if view is None:
            self.status_item.title = "chores: status unavailable"
        else:
            chores = view.get("chores", [])
            failures = {"FAILED", "TIMED_OUT", "BUDGET_EXCEEDED", "INTERRUPTED"}
            failed = [c["name"] for c in chores
                      if c.get("last_run") and c["last_run"]["status"] in failures]
            paused = view.get("paused")
            sched = view.get("scheduler", {})
            bits = [f"{len(chores)} chores"]
            if paused:
                bits.append(f"PAUSED: {paused}")
            if failed:
                bits.append("failed: " + ", ".join(failed))
            if sched.get("stale"):
                bits.append("scheduler STALE")
            if sched.get("installed") is False:
                bits.append("scheduler not installed")
            self.status_item.title = "chores: " + "; ".join(bits)
            self.pause_item.title = "Resume all" if paused else "Pause all"
        self.menu.add(self.status_item)
        if view:
            for w in view.get("warnings", [])[:3]:
                self.menu.add(f"[warning] {w[:80]}")
            for n in view.get("notifications", [])[:5]:
                self.menu.add(f"[{n['level']}] {n['text'][:80]}")
        if self.last_error:
            self.menu.add(f"(last check failed: {self.last_error[:80]})")
        self.menu.add(None)
        self.menu.add(self.open_item)
        self.menu.add(self.pause_item)
        self.menu.add(self.refresh_item)
        self.menu.add(self.quit_item)

    def open_dashboard(self, _):
        subprocess.Popen([str(REPO_ROOT / "bin" / "chores-dashboard")])

    def toggle_pause(self, _):
        verb = "resume" if (self.view and self.view.get("paused")) else "pause"
        args = [chores_bin(), verb] + (["paused from the menu bar"] if verb == "pause" else [])
        subprocess.run(args, capture_output=True, timeout=30)
        self.refresh(None)


if __name__ == "__main__":
    ChoresMonitor().run()
