#!/usr/bin/env bash
# bleed-guard -- refuse private strings in a public repo (issue #366).
#
# A public repo says so with a committed PUBLIC.REPO file at its root. In such
# a repo this scans what is being added -- staged added lines, and the names of
# added or renamed files -- for any entry of a private denylist, and exits 1
# on a hit. Matching is fixed-string and case-insensitive. A hit is reported as
# file:line plus the denylist entry's line number, NEVER the matched text: the
# report itself must not bleed into a log, a transcript or a PR comment.
#
# The denylist is private by construction -- publishing it would be the leak --
# so it lives outside this repo. One entry per line; blank lines and lines
# starting with # are ignored; surrounding whitespace is trimmed. Resolved:
#   $TDS_BLEED_DENYLIST -> git config bleedguard.denylist (--type=path)
#   -> ~/workplace/tds-internal/ops/bleed-denylist
# A missing denylist is a one-line skip, not a failure: most machines have no
# private checkout, and they must still be able to commit.
#
# Usage: bleed-guard           check the index (what git-hooks pre-commit runs)
#        bleed-guard --tree    audit every tracked file at HEAD's worktree
#
# Exit: 0 clean, skipped, or not a public repo; 1 a hit; 2 usage error.
# Opt out: TDS_BLEED_GUARD=0 or git config bleedguard.enabled false.
#
# Portability: bash 3.2 / BSD-safe (git hooks run under /bin/bash on macOS).

set -euo pipefail

# Byte semantics for awk/sed: under a UTF-8 locale BSD awk aborts on the first
# invalid byte (a Latin-1 fixture, a binary-ish text file), and a matcher that
# aborts reports no hits. Entries are ASCII identifiers, so C loses nothing.
export LC_ALL=C

# --- Constants ---

MARKER_FILE="PUBLIC.REPO"
DEFAULT_DENYLIST="${HOME:-}/workplace/tds-internal/ops/bleed-denylist"

# --- Predicates ---

is_disabled() {
    [ "${TDS_BLEED_GUARD:-1}" = "0" ] && return 0
    [ "$(git config --bool bleedguard.enabled 2>/dev/null || true)" = "false" ] && return 0
    return 1
}

is_public_repo() { [ -f "$1/${MARKER_FILE}" ]; }

# --- Helpers ---

note() { printf 'bleed-guard: %s\n' "$*" >&2; }

resolve_denylist() {
    local path="${TDS_BLEED_DENYLIST:-}"
    [ -n "${path}" ] || path="$(git config --type=path --get bleedguard.denylist 2>/dev/null || true)"
    [ -n "${path}" ] || path="${DEFAULT_DENYLIST}"
    printf '%s\n' "${path}"
}

# staged_records -- "path<TAB>line<TAB>text" for every added line in the index,
# plus "path<TAB>0<TAB>path" for every added or renamed file (its name is
# content too). Line numbers come from the new side of each -U0 hunk header.
staged_records() {
    git -c core.quotepath=false diff --cached -U0 --no-color --no-ext-diff \
        --no-renames --diff-filter=ACMR \
        | awk '
            /^\+\+\+ / { path = substr($0, 5); sub(/^b\//, "", path); next }
            /^@@ /     { split($3, h, ","); line = substr(h[1], 2) + 0; next }
            /^\+/      { printf "%s\t%d\t%s\n", path, line, substr($0, 2); line++ }
        '
    git -c core.quotepath=false diff --cached --name-only --diff-filter=AR \
        | awk '{ printf "%s\t0\t%s\n", $0, $0 }'
}

# tree_records -- the same shape for every line of every tracked text file.
# The file list is NUL-separated (-z) so no path is ever re-split; -I drops
# binaries, which have no lines to report.
tree_records() {
    git grep -z -l -I -e '' -- . 2>/dev/null \
        | xargs -0 awk '{ printf "%s\t%d\t%s\n", FILENAME, FNR, $0 }' || true
}

# match_records <denylist> -- read records on stdin; print one report line per
# (record, entry) hit, naming the entry by its line in the denylist file.
match_records() {
    awk -v list="$1" '
        BEGIN {
            n = 0
            while ((getline raw < list) > 0) {
                lineno++
                sub(/^[ \t]+/, "", raw); sub(/[ \t\r]+$/, "", raw)
                if (raw == "" || substr(raw, 1, 1) == "#") continue
                n++; entry[n] = tolower(raw); where[n] = lineno
            }
            close(list)
        }
        {
            tab1 = index($0, "\t"); path = substr($0, 1, tab1 - 1); rest = substr($0, tab1 + 1)
            tab2 = index(rest, "\t"); line = substr(rest, 1, tab2 - 1); text = tolower(substr(rest, tab2 + 1))
            for (i = 1; i <= n; i++) {
                if (index(text, entry[i]) == 0) continue
                if (line == 0) printf "%s: file name matches denylist entry at line %d\n", path, where[i]
                else           printf "%s:%s: matches denylist entry at line %d\n", path, line, where[i]
            }
        }
    '
}

# --- Flow ---

# scan <mode> <denylist> -- print the hits; return 1 when there are any.
scan() {
    local mode="$1" denylist="$2" hits
    if [ "${mode}" = tree ]; then
        hits="$(tree_records | match_records "${denylist}")"
    else
        hits="$(staged_records | match_records "${denylist}")"
    fi
    [ -z "${hits}" ] && return 0
    printf '%s\n' "${hits}" | sed 's/^/bleed-guard: /' >&2
    return 1
}

report_refusal() {
    note "refused: private strings from $1 are staged in a public repo."
    note "Remove them (the entry's line in the denylist says which), then commit again."
}

# --- Main ---

main() {
    local mode=index root denylist
    case "${1:-}" in
        '')     ;;
        --tree) mode=tree ;;
        -h|--help) sed -n '2,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; return 0 ;;
        *)      note "unknown argument: $1 (try --help)"; return 2 ;;
    esac

    root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    [ -n "${root}" ] || { note "not inside a git work tree"; return 2; }
    cd "${root}"

    is_disabled && return 0
    is_public_repo "${root}" || return 0

    denylist="$(resolve_denylist)"
    if [ ! -r "${denylist}" ]; then
        note "no denylist at ${denylist}; skipping (set TDS_BLEED_DENYLIST or bleedguard.denylist)."
        return 0
    fi

    if ! scan "${mode}" "${denylist}"; then
        [ "${mode}" = index ] && report_refusal "${denylist}"
        return 1
    fi
    return 0
}

main "$@"
