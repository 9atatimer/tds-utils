#!/usr/bin/env bash
# agent-instructions -- build each coding agent's instruction file and own its
# $HOME link.
#
# Every agent loads one global instruction file from $HOME. This builds that
# file per agent: the core every agent shares (clai.d/AGENT.global.md) and,
# when it exists, that agent's fragment (clai.d/<agent>/AGENT.<agent>.md). It
# writes the result to <data>/tds-utils/agents/<agent>.md and points the
# agent's $HOME link at it. An agent's rules that no other agent can use live
# in its fragment, so no agent loads another's.
#
# Usage: agent-instructions [-n] [-a agent] [check]
#   (no verb)  build every installed agent's file and point its link at it
#   check      change nothing; exit 1 if a file is stale or a link is wrong
#   -n         dry run: say what would change, change nothing
#   -a         one agent only (claude, codex, opencode, omp)
#
# An agent is installed when the directory its link lives in exists. A link
# that is a symlink is repointed; a missing one is created; a regular file is
# never touched, only reported. bin/tds-release runs this after it advances
# the public unit. Runbook: docs/ops/clai.md.
#
# Env (used by test/smoketest_agent_instructions.sh; not for daily use):
#   TDS_AGENT_SOURCE  the tree holding clai.d/ (default: this script's repo)
#
# Exit: 0 done (or, for check, all current); 1 something stale, wrong or
# refused; 2 usage error.

set -euo pipefail

AGENTS=(claude codex opencode omp)
CORE_REL="clai.d/AGENT.global.md"

# --- Action functions ---

usage() {
    echo "usage: agent-instructions [-n] [-a agent] [check]   (agents: ${AGENTS[*]})"
}

note() { echo "agent-instructions: $*"; }

is_known_agent() {
    local a
    for a in "${AGENTS[@]}"; do
        [[ "${a}" == "$1" ]] && return 0
    done
    return 1
}

# link_rel <agent> -- where the agent reads its global instructions, relative
# to $HOME. The one place that says so; adding an agent is one line here.
link_rel() {
    case "$1" in
        claude)   echo ".claude/CLAUDE.md" ;;
        codex)    echo ".codex/AGENTS.md" ;;
        opencode) echo ".config/opencode/AGENTS.md" ;;
        omp)      echo ".omp/agent/AGENTS.md" ;;
    esac
}

source_root() {
    if [[ -n "${TDS_AGENT_SOURCE:-}" ]]; then
        printf '%s\n' "${TDS_AGENT_SOURCE}"
    else
        (cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
    fi
}

data_dir() { printf '%s\n' "${XDG_DATA_HOME:-${HOME}/.local/share}/tds-utils/agents"; }

fragment_rel() { printf 'clai.d/%s/AGENT.%s.md\n' "$1" "$1"; }

# render <agent> <source> -- the file the agent should load, on stdout.
render() {
    local agent=$1 src=$2 fragment
    fragment="${src}/$(fragment_rel "${agent}")"
    printf '<!-- Generated by tds-utils bin/agent-instructions for %s from\n' "${agent}"
    printf '     %s and %s. Never edit this file:\n' "${CORE_REL}" "$(fragment_rel "${agent}")"
    printf '     edit those, land them, and run bin/tds-release. -->\n\n'
    cat "${src}/${CORE_REL}" || return 1
    if [[ -f "${fragment}" ]]; then
        printf '\n'
        cat "${fragment}" || return 1
    fi
}

# is_current <agent> <source> <built> -- the built file matches a fresh
# render. A render that fails is never current.
is_current() {
    local fresh
    [[ -f "$3" ]] || return 1
    fresh=$(mktemp "${TMPDIR:-/tmp}/agent-instructions.XXXXXX")
    if ! render "$1" "$2" >"${fresh}" 2>/dev/null; then
        rm -f "${fresh}"
        return 1
    fi
    cmp -s "${fresh}" "$3" && rm -f "${fresh}" && return 0
    rm -f "${fresh}"
    return 1
}

# write_built <agent> <source> <built> -- atomic: a reader never sees half a
# file, and a render that fails leaves the last good file in place.
write_built() {
    local tmp
    mkdir -p "$(dirname "$3")" || return 1
    tmp=$(mktemp "$3.XXXXXX") || return 1
    if ! render "$1" "$2" >"${tmp}"; then
        rm -f "${tmp}"
        return 1
    fi
    mv -f "${tmp}" "$3"
}

# --- Flow functions ---

# install_agent <agent> <source> <dry_run> -- returns 1 when refused.
install_agent() {
    local agent=$1 src=$2 dry_run=$3
    local link built
    link="${HOME}/$(link_rel "${agent}")"
    built="$(data_dir)/${agent}.md"
    if [[ ! -d "$(dirname "${link}")" ]]; then
        note "${agent}: not installed ($(dirname "${link}") is absent); skipped"
        return 0
    fi
    if [[ -e "${link}" && ! -L "${link}" ]]; then
        note "${agent}: ${link} is a regular file; not touching it"
        return 1
    fi
    if ! is_current "${agent}" "${src}" "${built}"; then
        if [[ "${dry_run}" -eq 1 ]]; then
            note "${agent}: would build ${built}"
        else
            if ! write_built "${agent}" "${src}" "${built}"; then
                note "${agent}: could not build ${built}; kept the last good file"
                return 1
            fi
            note "${agent}: built ${built}"
        fi
    fi
    if [[ "$(readlink "${link}" 2>/dev/null || true)" != "${built}" ]]; then
        if [[ "${dry_run}" -eq 1 ]]; then
            note "${agent}: would point ${link} -> ${built}"
        else
            ln -sfn "${built}" "${link}"
            note "${agent}: pointed ${link} -> ${built}"
        fi
    fi
}

# check_agent <agent> <source> -- returns 1 when the file or link is wrong.
check_agent() {
    local agent=$1 src=$2 link built
    link="${HOME}/$(link_rel "${agent}")"
    built="$(data_dir)/${agent}.md"
    [[ -d "$(dirname "${link}")" ]] || return 0
    if [[ "$(readlink "${link}" 2>/dev/null || true)" != "${built}" ]]; then
        note "${agent}: ${link} does not point at ${built}"
        return 1
    fi
    if ! is_current "${agent}" "${src}" "${built}"; then
        note "${agent}: ${built} is stale"
        return 1
    fi
}

run() {
    local verb=$1 dry_run=$2
    shift 2
    local src agent status=0
    src=$(source_root)
    if [[ ! -f "${src}/${CORE_REL}" ]]; then
        note "no core instruction file at ${src}/${CORE_REL}"
        return 1
    fi
    for agent in "$@"; do
        if [[ "${verb}" == check ]]; then
            check_agent "${agent}" "${src}" || status=1
        else
            install_agent "${agent}" "${src}" "${dry_run}" || status=1
        fi
    done
    return "${status}"
}

# --- Main ---

main() {
    local dry_run=0 only="" verb=install opt
    while getopts "na:h" opt; do
        case "${opt}" in
            n) dry_run=1 ;;
            a) only=$OPTARG ;;
            h) usage; exit 0 ;;
            *) usage >&2; exit 2 ;;
        esac
    done
    shift $((OPTIND - 1))
    case "${1:-}" in
        "") ;;
        check) verb=check ;;
        *) usage >&2; exit 2 ;;
    esac
    if [[ -n "${only}" ]] && ! is_known_agent "${only}"; then
        echo "agent-instructions: unknown agent '${only}'" >&2
        usage >&2
        exit 2
    fi
    local -a agents=("${AGENTS[@]}")
    [[ -z "${only}" ]] || agents=("${only}")
    run "${verb}" "${dry_run}" "${agents[@]}"
}

main "$@"
