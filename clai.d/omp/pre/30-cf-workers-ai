#!/usr/bin/env bash
# 30-cf-workers-ai -- clai pre-hook for omp (oh-my-pi).
#
# Writes the `cf-workers-ai` provider into ~/.omp/agent/models.yml: Workers
# AI's OpenAI-compatible route through the personal AI Gateway (tds-internal
# ops/terraform/ai-gateway). The token is never written to the file.
#
# The key: omp runs the file's `apiKey: "!<command>"` itself, once per
# process, and again 30 s after any failure. With `!op read` that was a
# 1Password prompt per launch, and a prompt left past omp's 10 s limit came
# back every 30 s. So the key lives in the login Keychain, seeded once by
# a human with clai.d/omp/seed-gateway-key.zsh, and the file reads it with
# `security`, which needs no prompt. Until it is seeded, CLAI_OMP_CF_KEY_REF
# (an op:// reference) gives the old `!op read`; with neither, the hook
# writes nothing and says to seed.
#
# The routing: the base URL and gateway id name the account, so they live
# only on this machine: in models.yml and in ROUTING_STATE beside it, which
# survives models.yml being deleted (seen on 2026-11-08). The hook keeps
# them from either, and reads 1Password only when both are gone (a new
# machine) or when CLAI_OMP_REFRESH=1: the one item tagged ROUTING_TAG, or the item
# CLAI_OMP_CF_OP_ITEM names. This public repo names tags, never a vault or
# an item.
#
# omp's key is its own token, not the routing item's, so the gateway can
# tell omp's spend from other callers'.
#
# The hook owns models.yml only while it carries the MARKER line: a
# hand-written file is left alone. It rewrites an owned file whenever what
# it would write differs, so seeding the Keychain takes effect at the next
# launch. The model roles, Kimi's included, are 40-model-roles'.
#
# Environment (tests only): CLAI_OMP_KEYCHAIN, a keychain file to search
# instead of the default keychains.
#
# Fail-open: a non-zero pre-hook aborts the launch, so every path exits 0.

set -euo pipefail

MODELS_YML="${HOME}/.omp/agent/models.yml"
MARKER="# managed by tds-utils clai.d/omp/pre/30-cf-workers-ai"
ROUTING_TAG="ai-gateway-routing"
ROUTING_STATE="${HOME}/.omp/agent/.tds-cf-routing"
KEY_SERVICE="tds.omp.cf-gateway-key"
KEY_ACCOUNT="omp"

# --- Helpers ---

log() { echo "[clai.d/omp/30-cf-workers-ai] $*" >&2; }

owned_or_absent() {
    [[ ! -e "${MODELS_YML}" ]] || grep -qxF "${MARKER}" "${MODELS_YML}"
}

# Prints the omp `!command` that yields the key, or nothing.
key_command() {
    local -a kc=()
    [[ -n "${CLAI_OMP_KEYCHAIN:-}" ]] && kc=("${CLAI_OMP_KEYCHAIN}")
    # Without -w, security reports whether the item exists and reads no secret.
    if command -v security >/dev/null 2>&1 &&
        security find-generic-password -s "${KEY_SERVICE}" -a "${KEY_ACCOUNT}" "${kc[@]}" >/dev/null 2>&1; then
        echo "!security find-generic-password -s ${KEY_SERVICE} -a ${KEY_ACCOUNT} -w${kc[*]:+ ${kc[*]}}"
    elif [[ -n "${CLAI_OMP_CF_KEY_REF:-}" ]]; then
        echo "!op read '${CLAI_OMP_CF_KEY_REF}'"
    fi
}

# Prints "<base_url> <gateway_id>" from the file this hook wrote before,
# or from ROUTING_STATE.
routing_from_file() {
    [[ "${CLAI_OMP_REFRESH:-0}" != "1" ]] || return 1
    if [[ -r "${MODELS_YML}" ]] &&
        awk '$1 == "baseUrl:" { u = $2 } $1 == "cf-aig-gateway-id:" { g = $2 }
             END { if (u != "" && g != "") print u, g; else exit 1 }' "${MODELS_YML}"; then
        return 0
    fi
    [[ -s "${ROUTING_STATE}" ]] && awk 'NF == 2 { print; f = 1 } END { exit !f }' "${ROUTING_STATE}"
}

# Prints the op:// item of the routing: CLAI_OMP_CF_OP_ITEM, or the one
# item tagged ROUTING_TAG.
routing_item() {
    if [[ -n "${CLAI_OMP_CF_OP_ITEM:-}" ]]; then
        echo "${CLAI_OMP_CF_OP_ITEM}"
        return 0
    fi
    local items
    items="$(op item list --tags "${ROUTING_TAG}" --format json)" || return 1
    [[ "$(jq 'length' <<<"${items}")" == 1 ]] || {
        log "want exactly one 1Password item tagged ${ROUTING_TAG}"
        return 1
    }
    jq -r '.[0] | "op://\(.vault.id)/\(.id)"' <<<"${items}"
}

routing_from_op() {
    command -v op >/dev/null 2>&1 || { log "op not on PATH"; return 1; }
    local item base_url gateway_id
    item="$(routing_item)" || return 1
    base_url="$(op read "${item}/gateway/base_url")" || return 1
    gateway_id="$(op read "${item}/gateway/gateway_id")" || return 1
    echo "${base_url} ${gateway_id}"
}

render() {
    local base_url="$1" gateway_id="$2" key="$3"
    cat <<YML
${MARKER}
# Edit the hook, not this file; delete the marker line to take it over.
providers:
  cf-workers-ai:
    baseUrl: ${base_url}
    api: openai-completions
    apiKey: "${key}"
    headers:
      cf-aig-gateway-id: ${gateway_id}
      cf-aig-metadata: '{"tool":"omp"}'
    models:
      - id: "@cf/moonshotai/kimi-k2.7-code"
        name: Kimi K2.7 Code (Workers AI)
        reasoning: true
        input: [text]
        contextWindow: 262144
        maxTokens: 32768
YML
}

# --- Flow functions ---

write_models() {
    local key routing tmp
    key="$(key_command)"
    [[ -n "${key}" ]] || {
        log "no key: run clai.d/omp/seed-gateway-key.zsh once (or set CLAI_OMP_CF_KEY_REF)"
        return 0
    }
    routing="$(routing_from_file)" || routing="$(routing_from_op)" || {
        log "no gateway routing (1Password); skipping"
        return 0
    }
    mkdir -p "$(dirname "${MODELS_YML}")"
    tmp="$(mktemp "${MODELS_YML}.XXXXXX")"
    # shellcheck disable=SC2086  # routing is two words, on purpose
    render ${routing} "${key}" > "${tmp}"
    printf '%s\n' "${routing}" > "${ROUTING_STATE}"
    if [[ -e "${MODELS_YML}" ]] && cmp -s "${tmp}" "${MODELS_YML}"; then
        rm -f "${tmp}"
        return 0
    fi
    mv -f "${tmp}" "${MODELS_YML}"
    log "wrote ${MODELS_YML}"
}

# --- Main ---

main() {
    command -v jq >/dev/null 2>&1 || { log "jq not found; skipping"; exit 0; }
    owned_or_absent || { log "${MODELS_YML} is hand-managed; leaving it"; exit 0; }
    write_models || log "write failed (non-fatal)"
    exit 0
}

main "$@"
