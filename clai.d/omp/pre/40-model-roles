#!/usr/bin/env bash
# 40-model-roles -- clai pre-hook for omp: interactive roles on GitHub
# Copilot, the task role on the laptop's local ollama.
#
# omp picks a model by role, and its bundled agents name a role, not a
# model: scout and sonic run on @smol, task on @task, reviewer on @slow.
# The interactive roles run on a GitHub Copilot model through the owner's
# own `omp login github-copilot` (owner, 2026-11-08): no 1Password, no
# Cloudflare gateway. The task role -- the one every code-changing
# sub-agent runs on -- runs on local ollama, so sub-agent inference is
# free (owner, 2026-11-09).
#
#   strong (CLAI_OMP_STRONG_MODEL): default
#   deep   (CLAI_OMP_DEEP_MODEL):   slow plan advisor
#   bulk   (CLAI_OMP_BULK_MODEL):   smol commit tiny memory widget
#   task   (CLAI_OMP_TASK_MODEL):   task
#
# Each Copilot default is a model that answers through omp; Copilot lists
# some it refuses to omp's integration id (kimi-k2.7-code, gpt-5.5,
# gpt-5.4-mini), so check `omp -p --model <m>` before changing one. The
# owner wants Kimi as the default (2026-11-08); kimi-k2.7-code is refused,
# kimi-k3 answers.
#
# The other local providers (llama.cpp, lm-studio, apple) stay in
# disabledProviders; ollama is REMOVED from that list -- an earlier
# version of this hook put it there, and the update only ever added --
# so omp discovers it. Every fallback chain that earlier version wrote
# is still removed: one keyed on, or falling back to, the local model or
# a Cloudflare gateway model (the provider 30-cf-workers-ai no longer
# writes by default). The task role STARTS on the local model rather than
# falling back to it; nothing falls back from Copilot to the gateway or
# to a local model, and a usage limit on Copilot is shown, not routed
# around.
#
# Ownership: the hook writes only when what it wants differs from what it
# last wrote (STAMP), so a role the human changes by hand stays changed
# until this file changes. It merges into modelRoles, disabledProviders and
# retry.fallbackChains; other entries are left alone. CLAI_OMP_REFRESH=1
# reapplies.
#
# Fail-open: a non-zero pre-hook aborts the launch, so every path exits 0.

set -euo pipefail

STRONG="${CLAI_OMP_STRONG_MODEL:-github-copilot/kimi-k3}"
DEEP="${CLAI_OMP_DEEP_MODEL:-github-copilot/claude-opus-5.5}"
BULK="${CLAI_OMP_BULK_MODEL:-github-copilot/claude-haiku-5.5}"
TASK="${CLAI_OMP_TASK_MODEL:-ollama/omp-coder:latest}"
STAMP="${HOME}/.omp/agent/.tds-model-roles"
DEEP_ROLES=(slow plan advisor)
BULK_ROLES=(smol commit tiny memory widget)
TASK_ROLES=(task)
LOCAL_PROVIDERS='["llama.cpp","lm-studio","apple"]'
# What an earlier version of this hook chained to: the local model it
# built, and any model on the Cloudflare gateway provider (30-cf-workers-ai).
OLD_LOCAL="ollama/omp-coder:latest"
OLD_GATEWAY_PREFIX="cf-workers-ai/"

# --- Helpers ---

log() { echo "[clai.d/omp/40-model-roles] $*" >&2; }

# --- Action functions ---

# The roles this hook wants, plus the providers it disables, as one object.
desired() {
    local role roles
    roles="$(jq -nc --arg m "${STRONG}" '{default: $m}')"
    for role in "${DEEP_ROLES[@]}"; do
        roles="$(jq -c --arg r "${role}" --arg m "${DEEP}" '.[$r] = $m' <<<"${roles}")"
    done
    for role in "${BULK_ROLES[@]}"; do
        roles="$(jq -c --arg r "${role}" --arg m "${BULK}" '.[$r] = $m' <<<"${roles}")"
    done
    for role in "${TASK_ROLES[@]}"; do
        roles="$(jq -c --arg r "${role}" --arg m "${TASK}" '.[$r] = $m' <<<"${roles}")"
    done
    jq -nc --argjson r "${roles}" --argjson p "${LOCAL_PROVIDERS}" '{roles: $r, disabled: $p}'
}

# Applies jq filter $3 to setting $1 (absent: the JSON $2); $4 is $add.
update_setting() {
    local key="$1" empty="$2" filter="$3" add="$4" cur
    cur="$(omp config get "${key}" --json | jq -c --argjson e "${empty}" '.value // $e')" || return 1
    omp config set "${key}" "$(jq -c --argjson add "${add}" "${filter}" <<<"${cur}")" >/dev/null || return 1
}

# --- Flow functions ---

# The single-quoted '$add' strings are jq filters, not shell expansions.
# shellcheck disable=SC2016
apply_roles() {
    local want
    want="$(desired)" || return 1
    if [[ "${CLAI_OMP_REFRESH:-0}" != "1" && -r "${STAMP}" && "$(cat "${STAMP}")" == "${want}" ]]; then
        return 0
    fi
    # set -e does not reach into a function called with ||, so each step
    # returns on failure itself: the stamp is written only after all landed.
    # Without a default role, interactive omp opens its setup wizard.
    omp config set startup.setupWizard false >/dev/null || return 1
    update_setting modelRoles '{}' '. + $add' "$(jq -c .roles <<<"${want}")" || return 1
    # Add the still-disabled local providers, remove ollama: the previous
    # policy put it there, and a hand-added ollama would survive only
    # until this hook's next own change, by the stamp rule.
    update_setting disabledProviders '[]' '. - $add.remove | . + ($add.add - .)' \
        "$(jq -nc --argjson p "${LOCAL_PROVIDERS}" '{add: $p, remove: ["ollama"]}')" || return 1
    update_setting retry.fallbackChains '{}' \
        'with_entries(select(((.key | startswith($add.gw)) or (.value | any(. == $add.local or startswith($add.gw)))) | not))' \
        "$(jq -nc --arg l "${OLD_LOCAL}" --arg g "${OLD_GATEWAY_PREFIX}" '{local: $l, gw: $g}')" || return 1
    mkdir -p "$(dirname "${STAMP}")" && printf '%s\n' "${want}" > "${STAMP}" || return 1
    log "roles: ${STRONG} (default), ${DEEP} (${DEEP_ROLES[*]}), ${BULK} (${BULK_ROLES[*]}) on Copilot; ${TASK} (${TASK_ROLES[*]}) on local ollama"
}

# --- Main ---

main() {
    command -v omp >/dev/null 2>&1 || { log "omp not on PATH; skipping"; exit 0; }
    command -v jq >/dev/null 2>&1 || { log "jq not found; skipping"; exit 0; }
    apply_roles || log "setting roles failed (non-fatal)"
    exit 0
}

main "$@"
