#!/usr/bin/env bash
# 40-enable-emacs-mcp -- clai pre-hook for claude
#
# Ensures ~/.claude.json registers the emacs MCP server (emacs-mcp-server
# running inside Emacs, reached over its Unix domain socket via socat),
# and removes "emacs" from every project's disabledMcpServers list.
# Idempotent. Never touches unrelated mcpServers or projects keys.
#
# The socket path must match mcp-server-socket-directory in init.el.
# When Emacs (or the server) is not running, socat fails fast and the
# client simply reports the server as unavailable -- no hang.
#
# Skips silently if ~/.claude.json is absent, or if jq or socat is not
# installed.

set -euo pipefail

CLAUDE_JSON="${HOME}/.claude.json"
SOCKET_PATH="${HOME}/.emacs.d/.cache/emacs-mcp-server.sock"

main() {
    [[ -f "${CLAUDE_JSON}" ]] || exit 0
    command -v jq >/dev/null 2>&1 || {
        echo "clai/enable-emacs-mcp: jq not found; skipping." >&2
        exit 0
    }
    command -v socat >/dev/null 2>&1 || {
        echo "clai/enable-emacs-mcp: socat not found; skipping." >&2
        exit 0
    }

    local tmp
    tmp="$(mktemp "${CLAUDE_JSON}.XXXXXX")"
    trap 'rm -f "${tmp}"' EXIT

    jq --arg sock "UNIX-CONNECT:${SOCKET_PATH}" '
        .mcpServers = (.mcpServers // {}) |
        .mcpServers["emacs"] = {command: "socat", args: ["-", $sock]} |
        .projects = (.projects // {}) |
        .projects |= map_values(
            if (.disabledMcpServers? != null) then
                .disabledMcpServers = (.disabledMcpServers - ["emacs"])
            else . end
        )
    ' "${CLAUDE_JSON}" > "${tmp}"

    jq empty "${tmp}" >/dev/null
    mv -f "${tmp}" "${CLAUDE_JSON}"
    trap - EXIT
}

main "$@"
