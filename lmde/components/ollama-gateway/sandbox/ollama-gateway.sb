;; ollama-gateway.sb -- macOS sandbox profile for the Ollama Gateway's
;; external ollama (docs/design/OLLAMA-GATEWAY.DESIGN.md, G4, Key Decisions
;; Q7). Applied by libexec/launch-ollama.zsh with sandbox-exec, to the G4
;; probe first and then to `ollama serve`, with identical parameters.
;;
;; This text is not the guarantee. libexec/probe.zsh is: it runs under this
;; profile before every start and the launcher refuses to start ollama
;; unless every assertion holds (the confinement-mechanism seam).
;;
;; Parameters (sandbox-exec -D NAME=VALUE), all resolved absolute paths:
;;   USER_HOME     the user's home directory
;;   GATEWAY_TREE  the gateway's config tree under ~/.local/ (read-only here)
;;   GATEWAY_HOME  ollama's HOME inside the tree (the one writable subtree)
;;   MODEL_STORE   the everyday model store (read-only here)
;;
;; Rule order matters: in SBPL the last matching rule wins, so each allow
;; below narrows the home-wide deny above it, and each deny after an allow
;; takes part of that allow back.

(version 1)

;; First cut: broad outside $HOME (Security Considerations; the hardening
;; pass narrows system paths and outbound network later).
(allow default)

;; G4: under $HOME, an allow-list. Everything else -- ~/.ssh, AI tool
;; credentials, 1Password data, ~/.ollama/id_ed25519, the login keychain
;; file -- is denied.
(deny file-read* file-write* (subpath (param "USER_HOME")))
(allow file-read-metadata (literal (param "USER_HOME")))
(allow file-read* (subpath (param "GATEWAY_TREE")))
(allow file-write* (subpath (param "GATEWAY_HOME")))
(allow file-read* (subpath (param "MODEL_STORE")))
;; The store's parent: metadata only (stat, no listing, no file reads).
;; ollama 0.40.3 lstats each component of the store path and rejects every
;; manifest without it (Issue#443); ~/.ollama/id_ed25519 and history stay
;; denied by the home-wide rule above.
(allow file-read-metadata (literal (param "MODEL_STORE_PARENT")))

;; Q7, first cut: the store is read-only. Stated explicitly so it holds
;; even for a store that lives outside $HOME.
(deny file-write* (subpath (param "MODEL_STORE")))

;; Q7, first cut: no loopback reach to the everyday ollama, which has no
;; auth and exposes model management.
(deny network-outbound (remote tcp "*:11434"))

;; G4: the connector's run token is unretrievable by any means. A keychain
;; item is not read by path: the CLI is denied outright, and the keychain
;; daemons' mach services are denied so the Security framework fails from
;; any binary, a copied or bundled one included.
(deny process-exec (literal "/usr/bin/security"))
(deny mach-lookup (global-name-regex #"^com\.apple\.(SecurityServer|securityd|secd|security\.)"))
