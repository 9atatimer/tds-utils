# chores -- laptop-local herd of LLM-adjacent scheduled jobs (docs/design/CHORES.DESIGN.md)
# The monitor's icons live under chores/assets/ so this package ships them
# (assets/ belongs to lmde.pkg); macos/apps/chores ships with macos-apps.pkg.
NAME=chores
DESC="chores scheduler, CLI, TUI and menu-bar monitor"
PATHS="chores bin/chores bin/chores-dashboard bin/chores-monitor bin/launch-chores-monitor macos/launchd/com.tds.chores-monitor.plist"
BINS="bin/chores bin/chores-dashboard bin/chores-monitor bin/launch-chores-monitor"
SERVICES="macos/launchd/com.tds.chores-monitor.plist"
VERIFY=chores/verify.sh
