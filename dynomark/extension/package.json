{
  "name": "dynomark-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Dynomark browser extension (MV3): files Follow Up saves into the native bookmark tree. See docs/design/DYNOMARK.DESIGN.md.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --sequence.shuffle",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "e2e": "vitest run --config vitest.integration.config.ts && playwright test"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
