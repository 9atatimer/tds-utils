{
  "manifest_version": 3,
  "name": "Dynomark",
  "version": "0.0.0",
  "description": "Live AI filing for native bookmarks: saves into Follow Up are captured, summarized and filed by a local daemon.",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["bookmarks", "history", "nativeMessaging", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "omnibox": {
    "keyword": "bm"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Dynomark",
    "default_popup": "history.html"
  }
}
