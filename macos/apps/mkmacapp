#!/bin/zsh
# mkmacapp -- turn a repo command into a double-clickable macOS .app bundle.
#
# Wraps the command in a compiled AppleScript applet that runs it and reports
# the result as a notification, then installs a custom icon over the stock
# applet artwork. See docs/design/MACOS-APPS.DESIGN.md.
#
# Three pieces of bundle trivia are baked in here so no caller has to know them:
#
#   - Modern osacompile emits an Assets.car plus a CFBundleIconName key, and
#     both outrank Contents/Resources/applet.icns. A custom icon is ignored
#     until they are removed.
#   - codesign refuses to sign a bundle carrying extended attributes, failing
#     with "resource fork, Finder information, or similar detritus not
#     allowed". xattr -cr must run first.
#   - The command must be a real executable path, not a shell alias. Aliases
#     from macos/dot.alias exist only in interactive zsh and are invisible to
#     Launch Services -- hence PATH is set to the repo's bin/ instead.

set -euo pipefail

readonly SCRIPT_PATH="${0:A}"
readonly REPO_ROOT="${SCRIPT_PATH:h:h:h}"
readonly IDENTIFIER_PREFIX="net.nineatatime"

# Homebrew lives outside the default `do shell script` PATH, and repo tools
# routinely shell out to it (monctl needs m1ddc).
readonly RUNTIME_PATH="${REPO_ROOT}/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"

usage() {
    cat <<'EOF'
usage: mkmacapp --name NAME --command CMD [options]

  --name NAME        bundle and display name, e.g. "Flip Monitor"
  --command CMD      shell command to run, with the repo bin/ on PATH
  --icon PATH        .icns file to use as the bundle icon
  --identifier ID    CFBundleIdentifier (default: derived from --name)
  --dest DIR         directory to build into (default: ~/Applications)
  --dock             also pin the finished bundle to the Dock
  --force            replace an existing bundle at that path
  -h, --help         this message
EOF
}

die() { print -u2 "mkmacapp: $*"; return 1; }

# --- Action functions ---

# --name becomes ${dest}/${name}.app, which --force hands to rm -rf. A name
# carrying a path separator or a dot component escapes dest and deletes
# something else, so refuse it before any of that runs.
validate_name() {
    local name=$1
    # `die` returns from itself, not from here -- so a bad name must fall
    # through to the explicit `return 1` below, and a good one returns early.
    case "${name}" in
        (*/*)      die "name may not contain '/': ${name}" ;;
        (.|..)     die "name may not be '.' or '..'" ;;
        ("")       die "name may not be empty" ;;
        (*)        return 0 ;;
    esac
    return 1
}

# Lowercase, strip everything that is not alphanumeric: "Flip Monitor" ->
# "flipmonitor". Reverse-DNS labels do not admit spaces or punctuation.
derive_identifier() {
    local name=$1 slug
    slug=$(print -r -- "${name}" | tr '[:upper:]' '[:lower:]' | tr -cd '[:alnum:]')
    [[ -n "${slug}" ]] || die "cannot derive an identifier from name '${name}'"
    print -r -- "${IDENTIFIER_PREFIX}.${slug}"
}

# Escape a string for embedding in an AppleScript double-quoted literal.
# Backslash first, or it doubles the escapes introduced for the quotes.
applescript_quote() {
    local text=$1
    text=${text//\\/\\\\}
    text=${text//\"/\\\"}
    print -r -- "${text}"
}

# The applet source. Reports on both paths: a silent launcher is
# indistinguishable from one that did not fire.
generate_source() {
    local name=$1 command=$2 out=$3
    local esc_cmd esc_name
    esc_cmd=$(applescript_quote "export PATH=${RUNTIME_PATH}; ${command}")
    esc_name=$(applescript_quote "${name}")

    cat > "${out}" <<EOF
-- ${name} -- generated by macos/apps/mkmacapp. Do not edit; rebuild instead.

on run
	try
		set outText to do shell script "${esc_cmd}"
		if outText is "" then set outText to "done"
		display notification outText with title "${esc_name}"
	on error errMsg
		display notification errMsg with title "${esc_name}" subtitle "failed"
	end try
end run
EOF
}

compile_bundle() {
    local source=$1 app=$2
    osacompile -o "${app}" "${source}" \
        || die "osacompile failed for '${app}'"
}

# Make the supplied icon the one Finder and the Dock actually show.
install_icon() {
    local app=$1 icon=$2
    cp "${icon}" "${app}/Contents/Resources/applet.icns"
    rm -f "${app}/Contents/Resources/Assets.car"
    plist_delete "${app}" CFBundleIconName
    plist_set "${app}" CFBundleIconFile string applet
}

plist_set() {
    local app=$1 key=$2 type=$3 value=$4
    local plist="${app}/Contents/Info.plist"
    /usr/libexec/PlistBuddy -c "Add :${key} ${type} ${value}" "${plist}" \
        >/dev/null 2>&1 \
        || /usr/libexec/PlistBuddy -c "Set :${key} ${value}" "${plist}" >/dev/null
}

plist_delete() {
    local app=$1 key=$2
    /usr/libexec/PlistBuddy -c "Delete :${key}" "${app}/Contents/Info.plist" \
        >/dev/null 2>&1 || true
}

# xattr must precede codesign; see the header note.
sign_bundle() {
    local app=$1
    xattr -cr "${app}"
    codesign -f -s - "${app}" >/dev/null 2>&1 \
        || die "codesign failed for '${app}'"
    touch "${app}"
}

# Percent-encode everything outside the unreserved set. Doing it this way
# rather than XML-escaping means &, <, >, and " cannot reach the plist
# snippet at all, so the XML is safe by construction. LC_ALL=C makes the
# loop index bytes, so multibyte UTF-8 encodes byte-wise as URLs require.
url_encode_path() {
    local text=$1 out="" char i
    local LC_ALL=C
    for (( i = 1; i <= ${#text}; i++ )); do
        char=${text[i]}
        case "${char}" in
            ([A-Za-z0-9._~/:-]) out+=${char} ;;
            (*)                 out+=$(printf '%%%02X' "'${char}") ;;
        esac
    done
    print -r -- "${out}"
}

# Pure: builds the tile snippet without touching the Dock, so it is testable.
dock_tile_xml() {
    local app=$1 url
    url="file://$(url_encode_path "${app}")/"
    print -r -- "<dict><key>tile-data</key><dict><key>file-data</key><dict><key>_CFURLString</key><string>${url}</string><key>_CFURLStringType</key><integer>15</integer></dict></dict><key>tile-type</key><string>file-tile</string></dict>"
}

pin_to_dock() {
    local app=$1
    defaults write com.apple.dock persistent-apps -array-add "$(dock_tile_xml "${app}")"
    killall Dock
}

# --- Flow functions ---

build_app() {
    local name=$1 command=$2 icon=$3 identifier=$4 dest=$5 dock=$6 force=$7
    local app="${dest}/${name}.app" source workdir

    [[ -n "${icon}" && ! -f "${icon}" ]] && die "icon not found: ${icon}"

    if [[ -e "${app}" ]]; then
        [[ "${force}" == true ]] || die "${app} exists (use --force to replace)"
        rm -rf "${app}"
    fi

    mkdir -p "${dest}"
    # A temp DIR, not `mktemp -t x).applescript`: that form writes to a path
    # mktemp never created and leaks the file it did create, every run.
    workdir=$(mktemp -d -t mkmacapp)
    source="${workdir}/applet.applescript"
    generate_source "${name}" "${command}" "${source}"

    compile_bundle "${source}" "${app}"
    rm -rf "${workdir}"

    [[ -n "${icon}" ]] && install_icon "${app}" "${icon}"
    plist_set "${app}" CFBundleIdentifier string "${identifier}"
    plist_set "${app}" CFBundleName string "${name}"
    sign_bundle "${app}"

    [[ "${dock}" == true ]] && pin_to_dock "${app}"

    print -r -- "built ${app}"
}

# --- Main ---

main() {
    local name="" command="" icon="" identifier="" dest="${HOME}/Applications"
    local dock=false force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)       name=${2:-};       shift 2 ;;
            --command)    command=${2:-};    shift 2 ;;
            --icon)       icon=${2:-};       shift 2 ;;
            --identifier) identifier=${2:-}; shift 2 ;;
            --dest)       dest=${2:-};       shift 2 ;;
            --dock)       dock=true;         shift ;;
            --force)      force=true;        shift ;;
            -h|--help)    usage; return 0 ;;
            *)            usage >&2; return 64 ;;
        esac
    done

    if [[ -z "${name}" || -z "${command}" ]]; then
        usage >&2
        return 64
    fi

    # A bad name is a usage error, not a build failure -- exit 64 like the rest.
    validate_name "${name}" || return 64

    [[ -n "${identifier}" ]] || identifier=$(derive_identifier "${name}")

    build_app "${name}" "${command}" "${icon}" "${identifier}" \
              "${dest}" "${dock}" "${force}"
}

# Sourceable as a library so the pure functions can be tested directly.
[[ -n "${MKMACAPP_LIB:-}" ]] || main "$@"
